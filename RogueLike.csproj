<Project Sdk="Godot.NET.Sdk/4.6.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="gdUnit4.api" Version="5.0.*" />
    <PackageReference Include="gdUnit4.test.adapter" Version="3.0.*" />
  </ItemGroup>
  <!-- The Godot-free domain layer is its own assembly (Code/Domain/RogueLike.Domain.csproj). Its
       .cs files are owned by that project, so remove them from this Godot project's compile glob. -->
  <ItemGroup>
    <Compile Remove="Code/Domain/**/*.cs" />
    <ProjectReference Include="Code/Domain/RogueLike.Domain.csproj" />
  </ItemGroup>
  <!-- The old grep-based GuardDomainGodotFree target is gone: RogueLike.Domain.csproj has no Godot
       reference, so a `using Godot;` in the domain is now a compile-time error (a real wall). -->
</Project>
