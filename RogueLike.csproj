<Project Sdk="Godot.NET.Sdk/4.6.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <IsPackable>false</IsPackable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <!-- Pure Godot game/View project. Tests live in their OWN projects: Code/Domain.Tests (xUnit,
       Godot-free) and Code/View.Tests (gdUnit4, Godot.NET.Sdk, references this project). So this
       project carries no test packages and is not IsTestProject — it just renders + delegates. -->
  <ItemGroup>
    <Compile Remove="Code/Domain/**/*.cs" />
    <Compile Remove="Code/Domain.Tests/**/*.cs" />
    <Compile Remove="Code/View.Tests/**/*.cs" />
    <ProjectReference Include="Code/Domain/RogueLike.Domain.csproj" />
  </ItemGroup>
  <!-- The old grep-based GuardDomainGodotFree target is gone: RogueLike.Domain.csproj has no Godot
       reference, so a `using Godot;` in the domain is now a compile-time error (a real wall). -->
</Project>
